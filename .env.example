# Rogue NATS Server — Example Configuration
# Copy to .env for local overrides (never commit .env with real keys/secrets)

ROGUE_NATS_HOST=0.0.0.0
ROGUE_NATS_PORT=4222
ROGUE_NATS_WS_PORT=4223
ROGUE_NATS_HTTP_PORT=8222
ROGUE_NATS_DATA_DIR=./data
ROGUE_NATS_LOG_LEVEL=info

# Rogue Signal JSON-RPC endpoint for on-chain balance & reputation checks
ROGUE_RPC_URL=http://127.0.0.1:38845
ROGUE_CHAIN_ID=800055
ROGUE_LOOKBACK_BLOCKS=120

# Tokenomics thresholds (in ROGUE)
ROGUE_MIN_BALANCE_CHAT=1
ROGUE_MIN_BALANCE_LINKS=10
ROGUE_MIN_BALANCE_CREATE_ROOM=50
ROGUE_MAX_ROOMS_PER_ACCOUNT=3

# Comma-separated 0x admin addresses (defaults to RogueTreasuryAddress)
ROGUE_ADMIN_ADDRESSES=0xe9aaE535B7971A9AC8C6af0e4B524D02260D3a03
